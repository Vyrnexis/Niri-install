#!/usr/bin/env bash

# Display a concise Kitty reference matching the installed configuration.
set -euo pipefail

use_color=true
use_pager=true

# Print command-line usage for the cheatsheet.
usage() {
  printf 'Usage: kitty-cheatsheet [--plain] [--no-pager]\n'
}

# Send standard input through less on a terminal or directly to stdout.
display() {
  if [[ $use_pager == true && -t 1 ]] && command -v less >/dev/null 2>&1; then
    LESS="${LESS:--FIX}" less -R
  else
    command cat
  fi
}

while (($#)); do
  case "$1" in
    --plain) use_color=false ;;
    --no-pager) use_pager=false ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'kitty-cheatsheet: unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

BOLD="" DIM="" RESET="" HEADING="" ACCENT=""
if [[ $use_color == true && -t 1 && ${TERM:-dumb} != dumb && -z ${NO_COLOR:-} ]] \
  && command -v tput >/dev/null 2>&1 && tput colors >/dev/null 2>&1; then
  BOLD="$(tput bold)"
  DIM="$(tput dim)"
  RESET="$(tput sgr0)"
  HEADING="$(tput setaf 6)"
  ACCENT="$(tput setaf 2)"
fi

display <<EOF
${BOLD}${HEADING}KITTY CONFIGURATION CHEATSHEET${RESET}
${DIM}kitty_mod is Ctrl+Shift. Search this page with /pattern.${RESET}

${BOLD}${ACCENT}CLIPBOARD AND SCROLLBACK${RESET}
  Ctrl-Shift-c       Copy selection
  Ctrl-Shift-v       Paste clipboard
  Ctrl-Shift-Up/Down Scroll one line
  Ctrl-Shift-PgUp/Dn Scroll one page
  Ctrl-Shift-Home    Jump to top
  Ctrl-Shift-End     Jump to bottom
  Ctrl-Shift-h       Open scrollback in pager
  Ctrl-Shift-/       Search scrollback

${BOLD}${ACCENT}WINDOWS AND TABS${RESET}
  Ctrl-Shift-Enter   New window in current tab
  Ctrl-Shift-w       Close current window
  Ctrl-Shift-] / [   Next / previous window
  Ctrl-Shift-r       Enter window resize mode
  Ctrl-Shift-l       Cycle layout
  Ctrl-Shift-t       New tab
  Ctrl-Shift-q       Close current tab
  Ctrl-Shift-Right   Next tab
  Ctrl-Shift-Left    Previous tab
  Ctrl-Shift-Alt-t   Rename tab

${BOLD}${ACCENT}FONT SIZE AND KITTENS${RESET}
  Ctrl-Shift-= / +   Increase font size
  Ctrl-Shift--       Decrease font size
  Ctrl-Shift-Bksp    Reset font size
  Ctrl-Shift-e       Open a visible URL with hints
  Ctrl-Shift-u       Unicode input kitten
  kitten icat        Display images in the terminal
  kitten diff        View a side-by-side diff
  kitten ssh         Open an enhanced SSH session

${BOLD}${ACCENT}CONFIGURATION${RESET}
  Ctrl-Shift-F2      Edit kitty.conf
  Ctrl-Shift-F5      Reload kitty.conf
  kitty +edit-config Open the configuration editor
EOF
