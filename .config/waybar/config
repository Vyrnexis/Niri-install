// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "height": 42,
    "spacing": 3,
    "modules-left": [
        "custom/launcher",
        "clock",
        "custom/weather",
        "mpd"
    ],
    "modules-center": [
        "niri/workspaces"
    ],
    "modules-right": [
        "custom/idle",
        "cpu",
        "memory",
        "network",
        "backlight",
        "wireplumber",
        "battery",
        "power-profiles-daemon",
        "tray"
    ],
    "custom/launcher": {
      "format": "",
      "tooltip": false,
      "on-click": "sh -c 'command -v nimlaunch >/dev/null 2>&1 && exec nimlaunch || exec fuzzel'"
    },
    "niri/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "focused": "",
            "default": ""
        },
        "on-click": "niri msg action toggle-overview"
    },
    "mpd": {
        "format": "󰝚 {title}",
        "format-disconnected": "",
        "format-stopped": "",
        "unknown-tag": "N/A",
        "interval": 5,
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%H·%M}",
        "format-alt": "{:%a, %b %d %Y}"
    },
    "custom/idle": {
      "exec": "~/.config/waybar/scripts/idle_toggle.sh status",
      "on-click": "~/.config/waybar/scripts/idle_toggle.sh toggle",
      "return-type": "json",
      "interval": 3
    },
    "backlight": {
        "format": "{icon} {percent}",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-click": "~/.config/waybar/scripts/night-light"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-charging": "󰚥 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "interval": 30
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "󰗑",
        "power-saver": "󰌪"
      }
    },
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "swayosd-client --output-volume mute-toggle",
        "on-click-middle": "swayosd-client --output-volume mute-toggle",
        "on-scroll-up": "swayosd-client --output-volume +5 --max-volume 100",
        "on-scroll-down": "swayosd-client --output-volume -5",
        "on-click-right": "sh -c 'command -v pavucontrol >/dev/null 2>&1 && pavucontrol'"
    },
    "network": {
        "format-wifi": "󰖩 {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰖪 Offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "nm-connection-editor"
    },
    "cpu": {
        "format": " {usage}%",
        "tooltip": true,
        "interval": 5
    },
    "memory": {
        "format": " {percentage}%",
        "tooltip-format": "Memory: {used:0.1f} GiB / {total:0.1f} GiB",
        "interval": 5
    },
    "custom/weather": {
        "exec": "~/.config/waybar/scripts/weather.sh -o",
        "on-click": "kitty -e ~/.config/waybar/scripts/weather.sh",
        "interval": 600
    }
}
